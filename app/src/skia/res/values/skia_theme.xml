<?xml version="1.0" encoding="utf-8"?>
<!--
    CloudStream Skia: global look.

    Everything here overrides an upstream resource of the same name (app/src/main/res),
    so upstream files stay untouched. Keep overrides to single colors/dimens and to the
    small mode/overlay styles; never copy big upstream styles such as AppTheme.
-->
<resources>
    <!-- Skia palette: neutral darks with a faint warm tint that matches the crimson accent -->
    <color name="skia_ground">#0B0A0A</color>
    <color name="skia_surface">#171314</color>
    <color name="skia_surface_high">#201A1B</color>
    <color name="skia_line">#2D2527</color>
    <color name="skia_text">#F7F5F5</color>
    <color name="skia_text_muted">#A69FA1</color>
    <color name="skia_accent">#E0283E</color>
    <color name="skia_accent_dark">#9E1B2D</color>
    <color name="skia_on_accent">#FFFFFF</color>

    <!-- Upstream base colors (used by the "Black" mode and as defaults everywhere) -->
    <color name="colorPrimary">@color/skia_accent</color>
    <color name="colorAccent">@color/skia_accent</color>
    <color name="colorPrimaryDark">@color/skia_accent_dark</color>
    <color name="textColor">@color/skia_text</color>
    <color name="grayTextColor">@color/skia_text_muted</color>
    <color name="iconColor">@color/skia_text_muted</color>
    <color name="primaryGrayBackground">@color/skia_surface</color>
    <color name="primaryBlackBackground">@color/skia_ground</color>
    <color name="iconGrayBackground">@color/skia_surface_high</color>
    <color name="boxItemBackground">@color/skia_surface</color>
    <color name="amoledModeLight">@color/skia_surface</color>
    <color name="dubColorBg">@color/skia_accent</color>
    <color name="dubColorText">@color/skia_on_accent</color>

    <!-- Skeleton placeholders: upstream shimmer alphas (0.2 / 0.3) give about 6% / 10% white -->
    <color name="grayShimmer">#575153</color>

    <!-- Rounder corners -->
    <dimen name="rounded_image_radius">12dp</dimen>
    <dimen name="rounded_button_radius">14dp</dimen>
    <dimen name="card_corner_radius">12dp</dimen>
    <dimen name="loading_radius">12dp</dimen>

    <!-- Floating bottom navigation (labeled, so a little taller than upstream's 70dp) -->
    <dimen name="nav_view_height">74dp</dimen>
    <dimen name="skia_nav_margin">14dp</dimen>
    <dimen name="skia_nav_radius">24dp</dimen>
    <dimen name="skia_nav_item_padding">10dp</dimen>

    <!-- Page titles (Search, Library) -->
    <style name="SkiaPageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:textColor">?attr/textColor</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">@font/google_sans</item>
    </style>

    <dimen name="skia_search_height">52dp</dimen>

    <!-- Home source pill: distance below the status bar (level with the header buttons) -->
    <dimen name="skia_home_pill_offset">4dp</dimen>

    <!-- Home hero (Nuvio-like): height, artwork fade, logo box, distances from the bottom -->
    <dimen name="skia_hero_height">540dp</dimen>
    <dimen name="skia_hero_fade_height">260dp</dimen>
    <dimen name="skia_hero_logo_width">250dp</dimen>
    <dimen name="skia_hero_logo_height">96dp</dimen>
    <dimen name="skia_hero_button">52dp</dimen>
    <dimen name="skia_hero_buttons_bottom">34dp</dimen>
    <dimen name="skia_hero_dots_bottom">14dp</dimen>
    <dimen name="skia_hero_text_bottom">104dp</dimen>

    <!-- Details page -->
    <dimen name="skia_result_artwork_height">300dp</dimen>
    <dimen name="skia_primary_button_height">52dp</dimen>
    <dimen name="skia_primary_button_radius">26dp</dimen>
    <!-- Half of the 40dp button height: stadium shape -->
    <dimen name="skia_pill_radius">20dp</dimen>
    <dimen name="skia_icon_button">38dp</dimen>
    <dimen name="skia_icon_gap">6dp</dimen>

    <!--
        Buttons. WhiteButton is upstream's primary action style and BlackButton the secondary
        one. Skia, like Nuvio: the primary action is a white stadium pill with dark text, the
        accent is kept for progress, selection and navigation. WhiteButton does not inherit
        NiceButton because NiceButton's android:padding would override the side padding.
    -->
    <style name="WhiteButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:layout_marginEnd">5dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="iconGravity">textStart</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">6dp</item>
        <item name="cornerRadius">@dimen/skia_pill_radius</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:foreground">@drawable/outline_drawable_less</item>
        <item name="android:tag">@string/tv_no_focus_tag</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="strokeWidth">0dp</item>
        <item name="backgroundTint">?attr/textColor</item>
        <item name="iconTint">?attr/primaryBlackBackground</item>
        <item name="android:textColor">?attr/primaryBlackBackground</item>
        <item name="rippleColor">#26000000</item>
    </style>

    <style name="BlackButton" parent="NiceButton">
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">@dimen/skia_pill_radius</item>
        <item name="strokeColor">@color/skia_line</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">?attr/iconGrayBackground</item>
        <item name="iconTint">?attr/textColor</item>
        <item name="android:textColor">?attr/textColor</item>
        <item name="rippleColor">@color/black_button_ripple</item>
    </style>

    <!--
        Round icon button beside the hero Play pill. Upstream binds these as TextViews with a
        top drawable and a label; the label is drawn transparent and 1sp so only the icon shows.
    -->
    <style name="SkiaHeroCircle">
        <item name="android:layout_width">@dimen/skia_hero_button</item>
        <item name="android:layout_height">@dimen/skia_hero_button</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:background">@drawable/skia_hero_circle</item>
        <item name="android:gravity">center_horizontal|top</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:drawablePadding">0dp</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:textSize">1sp</item>
        <item name="android:textColor">@color/transparent</item>
        <item name="drawableTint">?attr/white</item>
    </style>

    <!--
        Bottom sheets float like Nuvio's: 10dp from the screen edges, all corners round, a
        hairline edge. The style is applied to the sheet view itself, so margins work here.
    -->
    <style name="AppBottomSheetDialogTheme">
        <item name="android:windowIsFloating">true</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/Animation.Design.BottomSheetDialog</item>
        <item name="bottomSheetStyle">@style/AppModalStyle</item>
    </style>

    <style name="AppModalStyle">
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="behavior_hideable">true</item>
        <item name="behavior_skipCollapsed">true</item>
        <item name="shapeAppearance">@null</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/skia_sheet_background</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="behavior_peekHeight">512dp</item>
    </style>

    <!-- Player side panel (source and subtitle picker), see SkiaPlayer.sidePanel -->
    <style name="SkiaSidePanelAnimation">
        <item name="android:windowEnterAnimation">@anim/skia_panel_in</item>
        <item name="android:windowExitAnimation">@anim/skia_panel_out</item>
    </style>

    <!-- Extended FABs (home source, details bookmark, library sort, random) -->
    <style name="ExtendedFloatingActionButton">
        <item name="elevation">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="backgroundTint">?attr/primaryGrayBackground</item>
        <item name="tint">?attr/colorPrimary</item>
        <item name="textColor">?attr/colorPrimary</item>
        <item name="iconTint">?attr/textColor</item>
        <item name="android:layout_margin">16dp</item>
        <item name="android:layout_gravity">end|bottom</item>
        <item name="textAllCaps">false</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- Small tag buttons (source, age rating, filler): taller so the font is not clipped -->
    <style name="SmallBlackButton" parent="BlackButton">
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="SmallWhiteButton" parent="WhiteButton">
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_marginStart">0dp</item>
        <item name="android:layout_marginEnd">0dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="iconPadding">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Player bottom row (Lock, Resize, Sources, ...): readable labels, rounder ripple -->
    <style name="VideoButton">
        <item name="android:stateListAnimator">@null</item>
        <item name="strokeColor">@color/transparent</item>
        <item name="backgroundTint">@color/transparent</item>
        <item name="rippleColor">@color/video_button_ripple</item>
        <item name="android:shadowColor">@color/transparent</item>

        <item name="cornerRadius">12dp</item>
        <item name="iconTint">@color/white</item>
        <item name="iconPadding">8dp</item>
        <item name="textColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">45dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <!-- Season / episode range / dub / sort selectors: pills -->
    <style name="MultiSelectButton" parent="BlackButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="backgroundTint">?attr/iconGrayBackground</item>
        <item name="iconTint">?attr/textColor</item>
        <item name="android:textColor">?attr/textColor</item>
        <item name="android:textSize">13sp</item>
        <item name="rippleColor">?attr/textColor</item>
    </style>

    <style name="SkiaNavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>

    <style name="SkiaNavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!--
        "AmoledLight" is the upstream default theme mode, so it carries the Skia palette.
        The other modes (Amoled, Dracula, Light, ...) keep their upstream look.
    -->
    <style name="AmoledModeLight" parent="AmoledMode">
        <item name="primaryBlackBackground">@color/skia_ground</item>
        <item name="primaryGrayBackground">@color/skia_surface</item>
        <item name="iconGrayBackground">@color/skia_surface_high</item>
        <item name="boxItemBackground">@color/skia_surface</item>
        <item name="textColor">@color/skia_text</item>
        <item name="grayTextColor">@color/skia_text_muted</item>
        <item name="iconColor">@color/skia_text_muted</item>
    </style>

    <!-- "Normal" is the upstream default primary color: Skia crimson with white text on it -->
    <style name="OverlayPrimaryColorNormal">
        <item name="colorPrimary">@color/skia_accent</item>
        <item name="android:colorPrimary">@color/skia_accent</item>
        <item name="colorPrimaryDark">@color/skia_accent_dark</item>
        <item name="colorAccent">@color/skia_accent</item>
        <item name="colorOnPrimary">@color/skia_on_accent</item>
        <item name="android:colorAccent">@color/skia_accent</item>
    </style>

    <!-- The system navigation bar sits under the floating nav, so it takes the ground color -->
    <style name="LoadedStyle">
        <item name="android:navigationBarColor">?attr/primaryBlackBackground</item>
        <item name="android:windowBackground">?attr/primaryBlackBackground</item>
        <!--
            LoadedStyle is applied last by CommonActivity.loadThemes, so it is also where Skia
            adds theme-wide attributes without copying AppTheme. Search fields use these:
        -->
        <item name="autoCompleteTextViewStyle">@style/SkiaAutoComplete</item>
        <item name="android:autoCompleteTextViewStyle">@style/SkiaAutoComplete</item>
    </style>

    <style name="SkiaAutoComplete" parent="Widget.AppCompat.AutoCompleteTextView">
        <item name="android:fontFamily">@font/google_sans</item>
        <item name="fontFamily">@font/google_sans</item>
    </style>
</resources>
