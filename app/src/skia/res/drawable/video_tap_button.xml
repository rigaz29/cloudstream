<?xml version="1.0" encoding="utf-8"?>
<!--
    CloudStream Skia override of app/src/main/res/drawable/video_tap_button.xml:
    the play/pause button gets a translucent round backing instead of a bare icon.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/video_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="#730B0A0A" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
</ripple>
