<?xml version="1.0" encoding="utf-8"?>
<!--
    CloudStream Skia override of app/src/main/res/drawable/video_tap_button_skip.xml:
    the 10 second seek buttons get a smaller translucent round backing.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/video_ripple">
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <solid android:color="#6609090B" />
            <stroke
                android:width="1dp"
                android:color="#26FFFFFF" />
        </shape>
    </item>
</ripple>
