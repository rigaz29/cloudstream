<?xml version="1.0" encoding="utf-8"?>
<!-- CloudStream Skia: round button on the surface color (e.g. voice search) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="?attr/primaryGrayBackground" />
            <stroke
                android:width="1dp"
                android:color="@color/skia_line" />
        </shape>
    </item>
</ripple>
