<?xml version="1.0" encoding="utf-8"?>
<!-- CloudStream Skia: search icon in a translucent circle, readable over bright artwork -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="38dp"
        android:height="38dp">
        <shape android:shape="oval">
            <solid android:color="#730B0A0A" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/search_icon"
        android:gravity="center" />
</layer-list>
