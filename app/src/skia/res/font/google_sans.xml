<?xml version="1.0" encoding="utf-8"?>
<!--
    CloudStream Skia: replaces the app-wide UI font (upstream: Product Sans)
    with Plus Jakarta Sans (SIL OFL 1.1, see app/src/skia/LICENSE-PlusJakartaSans-OFL.txt).
    The family keeps the upstream name so every existing @font/google_sans reference follows.
-->
<font-family xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        app:font="@font/plus_jakarta_sans_extra_light"
        app:fontStyle="normal"
        app:fontWeight="100" />

    <font
        app:font="@font/plus_jakarta_sans_light"
        app:fontStyle="normal"
        app:fontWeight="300" />

    <font
        app:font="@font/plus_jakarta_sans_regular"
        app:fontStyle="normal"
        app:fontWeight="400" />

    <font
        app:font="@font/plus_jakarta_sans_italic"
        app:fontStyle="italic"
        app:fontWeight="400" />

    <font
        app:font="@font/plus_jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="500" />

    <font
        app:font="@font/plus_jakarta_sans_medium_italic"
        app:fontStyle="italic"
        app:fontWeight="500" />

    <font
        app:font="@font/plus_jakarta_sans_semi_bold"
        app:fontStyle="normal"
        app:fontWeight="600" />

    <font
        app:font="@font/plus_jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="700" />

    <font
        app:font="@font/plus_jakarta_sans_bold_italic"
        app:fontStyle="italic"
        app:fontWeight="700" />

    <font
        app:font="@font/plus_jakarta_sans_extra_bold"
        app:fontStyle="normal"
        app:fontWeight="900" />
</font-family>
