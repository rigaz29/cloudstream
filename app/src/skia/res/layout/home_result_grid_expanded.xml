<?xml version="1.0" encoding="utf-8"?>
<!--
    CloudStream Skia override of app/src/main/res/layout/home_result_grid_expanded.xml.
    Same view ids as upstream; watchProgress is a SkiaResumeProgress (a ProgressBar, as the
    binder expects). Continue watching items (Nuvio-like): episode and time left over a bottom
    scrim, a thin progress line, a small play button. Other posters look as before.
-->


<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="2dp"
    android:backgroundTint="@color/transparent"
    android:foreground="@drawable/outline_drawable"
    app:cardCornerRadius="@dimen/rounded_image_radius"
    app:cardElevation="0dp">

    <!-- Needed for layout tests -->
    <ImageView
        android:id="@+id/title_shadow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView
            android:id="@+id/background_card"
            android:layout_width="114dp"
            android:layout_height="180dp"
            android:elevation="10dp"
            app:cardBackgroundColor="?attr/primaryGrayBackground"
            app:cardCornerRadius="@dimen/rounded_image_radius">

            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/search_poster_img_des"
                android:duplicateParentState="true"
                android:foreground="?android:attr/selectableItemBackgroundBorderless"
                android:scaleType="centerCrop"
                tools:src="@drawable/example_poster" />


            <!-- Skia: shown with watchProgress (SkiaResumeProgress) -->
            <View
                android:id="@+id/skia_resume_scrim"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_gravity="bottom"
                android:background="@drawable/skia_card_scrim"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/watch_progress_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/search_item_download_play"
                    style="@style/HomePlayUnderlayProgress"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="#A60B0A0A"
                    android:scaleType="fitCenter"
                    app:contentPadding="10dp"
                    app:strokeColor="#33FFFFFF"
                    app:strokeWidth="1dp" />
            </FrameLayout>

            <com.lagradost.cloudstream3.skia.SkiaResumeProgress
                android:id="@+id/watchProgress"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="8dp"
                android:progressDrawable="@drawable/skia_progress_pill"
                android:visibility="gone"
                tools:progress="50"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/text_quality"
                style="@style/TypeButton" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_is_dub"
                    style="@style/DubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_is_sub"
                    style="@style/SubButton"
                    android:layout_gravity="end" />

                <TextView
                    android:id="@+id/text_rating"
                    style="@style/RatingButton"
                    android:layout_gravity="end"
                    tools:text="7.7" />

                <TextView
                    android:id="@+id/text_flag"
                    style="@style/SearchBox"
                    android:layout_gravity="end"
                    android:background="@color/transparent"
                    android:textSize="20sp"
                    android:visibility="gone"
                    tools:text="🇸🇪"
                    tools:visibility="visible" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/episode_text"
                    style="@style/EpisodeTextButton"
                    android:layout_width="wrap_content"
                    android:layout_marginLeft="0dp"
                    android:background="@null"
                    android:minWidth="0dp"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="0dp"
                    android:shadowColor="#99000000"
                    android:shadowRadius="4"
                    android:textColor="@color/white"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/skia_resume_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowRadius="4"
                    android:textColor="#D9FFFFFF"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:text="12 min left"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/imageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:minLines="2"
            android:paddingStart="5dp"
            android:paddingTop="5dp"
            android:paddingEnd="5dp"
            android:paddingBottom="5dp"
            android:textColor="?attr/textColor"
            android:textSize="13sp"
            tools:text="The Perfect Run\nThe Perfect Run\nhello" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
